# Which environment's config file to use: local (default), dev or prod.
# PLATFORM_ENV=local

# Local only: where the DuckDB files and the landing folder go. Default is .local
# PLATFORM_HOME=.local

# dev and prod read their connections from these. Nothing secret is stored in config/.
# WAREHOUSE_URL=postgresql://user:password@host:5432/warehouse
# WAREHOUSE_URL=redshift://user:password@cluster.region.redshift.amazonaws.com:5439/dev
# SOURCE_URL=postgresql://reader:password@host:5432/app
# LANDING_URL=s3://my-bucket/landing

# Or override one connection by name, whatever the config file says.
# PLATFORM_CONN_WAREHOUSE=postgresql://...

# Inside Airflow: also look connections up in Airflow's own store, by the same names.
# PLATFORM_AIRFLOW_CONNECTIONS=1
